{
  "name": "tessera",
  "version": "0.2.0",
  "description": "Enterprise-grade security audit workflow engine powered by Temporal.io",
  "main": "lib/workflows/index.js",
  "types": "lib/workflows/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "start": "ts-node src/worker.ts",
    "workflow": "ts-node src/client.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:bdd": "cucumber-js --config .cucumber.js",
    "test:bdd:done": "cucumber-js --config .cucumber.js --tags \"(@US-001 or @US-002 or @US-003 or @US-004 or @US-005 or @US-006) and not @TS-023\"",
    "evidence:keygen": "ts-node src/cli/evidence-keygen.ts",
    "test:tools": "vitest run --config tests/contract/vitest.config.ts",
    "test:all": "npm run test && npm run test:bdd",
    "lint": "eslint src --ext .ts",
    "verify": "npm run build && npm run test:coverage && npm run lint",
    "demo": "node demo/run-demo.js",
    "dogfood": "node scripts/dogfood.js",
    "evidence:verify": "ts-node src/cli/verify-evidence.ts",
    "hooks:install": "git config core.hooksPath .githooks",
    "security:deps": "sh scripts/ci/deps.sh",
    "security:secrets": "sh scripts/ci/secrets.sh",
    "security:secrets:staged": "sh scripts/ci/secrets-staged.sh",
    "security:sast": "sh scripts/ci/sast.sh",
    "security:licenses": "sh scripts/ci/licenses.sh",
    "security": "npm run security:deps && npm run security:secrets && npm run security:sast && npm run security:licenses",
    "verify:full": "npm run verify && npm run test:bdd:done && npm run security",
    "test:bdd:legacy": "cucumber-js --config .cucumber.js --profile legacy"
  },
  "dependencies": {
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "axios": "^1.6.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@types/node": "^22.20.5",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^8.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "license": "MIT"
}
